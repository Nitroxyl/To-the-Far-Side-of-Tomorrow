rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Immutable founding GM is the root administrator. Additional verified
    // accounts are granted by the root through a UID + verified-email record.
    function rootGm() {
      return request.auth != null
        && request.auth.uid == 'ctBLgrVgkLOzUJYTyYgU9IwejYx1';
    }
    function gm() {
      return rootGm() || (
        request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/santara_gm_accounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/santara_gm_accounts/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/santara_gm_accounts/$(request.auth.uid)).data.email == request.auth.token.email
      );
    }
    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }
    function approved() {
      return verified()
        && exists(/databases/$(database)/documents/santara_player_access/$(request.auth.uid))
        && get(/databases/$(database)/documents/santara_player_access/$(request.auth.uid)).data.enabled == true;
    }
    function member() {
      return gm() || approved();
    }

    // A verified legacy account may request access using its existing UID.
    // ONLY the immutable root GM can grant new GM accounts.
    match /santara_gm_accounts/{uid} {
      allow get: if rootGm() || (verified() && request.auth.uid == uid);
      allow list: if rootGm();
      allow create, update: if rootGm()
        && uid != 'ctBLgrVgkLOzUJYTyYgU9IwejYx1'
        && request.resource.data.keys().hasOnly(['email','enabled','grantedAt'])
        && request.resource.data.keys().hasAll(['email','enabled','grantedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.enabled is bool
        && request.resource.data.grantedAt == request.time
        && exists(/databases/$(database)/documents/santara_access_requests/$(uid))
        && get(/databases/$(database)/documents/santara_access_requests/$(uid)).data.email == request.resource.data.email;
      allow delete: if rootGm();
    }

    // GM uploads only a public snapshot; verified, approved Trainers can read it.
    match /santara_publication/current {
      allow get: if member();
      allow list, delete: if false;
      allow create, update: if gm()
        && request.resource.data.keys().hasOnly(['bundle','updatedAt'])
        && request.resource.data.keys().hasAll(['bundle','updatedAt'])
        && request.resource.data.bundle is map
        && request.resource.data.bundle.keys().hasOnly([
          'kind','version','generatedAt','sites','requests','sightings'
        ])
        && request.resource.data.bundle.kind == 'santaraPublished'
        && request.resource.data.bundle.sites is list
        && request.resource.data.bundle.requests is list
        && request.resource.data.bundle.sightings is list
        && request.resource.data.updatedAt == request.time;
    }

    // A verified player can request approval for their own Firebase UID.
    match /santara_access_requests/{uid} {
      allow get: if gm() || (verified() && request.auth.uid == uid);
      allow list: if gm();
      allow create: if verified()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','createdAt'])
        && request.resource.data.keys().hasAll(['email','createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if gm();
    }

    // Only the GM can grant or revoke access.
    match /santara_player_access/{uid} {
      allow get: if gm() || (verified() && request.auth.uid == uid);
      allow list: if gm();
      allow create, update: if gm()
        && request.resource.data.keys().hasOnly(['email','enabled','approvedAt'])
        && request.resource.data.keys().hasAll(['email','enabled','approvedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.enabled is bool
        && request.resource.data.approvedAt == request.time;
      allow delete: if gm();
    }

    // Approved Trainers can browse cards; only an owner edits their own.
    match /santara_trainer_cards/{uid} {
      allow get, list: if member();
      allow create, update: if member()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'ownerUid','trainerName','trainerClass','hometown','partnerPokemon',
          'favoriteType','theme','avatar','badgeCount','quote','updatedAt',
          'trainerTitle','team','pattern','customPrimary','customSecondary',
          'portraitData','bannerData'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid','trainerName','trainerClass','hometown','partnerPokemon',
          'favoriteType','theme','avatar','badgeCount','quote','updatedAt',
          'trainerTitle','team','pattern','customPrimary','customSecondary',
          'portraitData','bannerData'
        ])
        && request.resource.data.ownerUid == uid
        && request.resource.data.trainerName is string
        && request.resource.data.trainerName.size() > 0
        && request.resource.data.trainerName.size() <= 32
        && request.resource.data.trainerClass is string
        && request.resource.data.trainerClass.size() <= 32
        && request.resource.data.trainerTitle is string
        && request.resource.data.trainerTitle.size() <= 32
        && request.resource.data.hometown is string
        && request.resource.data.hometown.size() <= 48
        && request.resource.data.partnerPokemon is string
        && request.resource.data.partnerPokemon.size() <= 48
        && request.resource.data.favoriteType is string
        && request.resource.data.favoriteType.size() <= 30
        && request.resource.data.theme in [
          'crimson','ocean','emerald','violet','amber','midnight','rose','frost'
        ]
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 12
        && request.resource.data.badgeCount is int
        && request.resource.data.badgeCount >= 0
        && request.resource.data.badgeCount <= 8
        && request.resource.data.quote is string
        && request.resource.data.quote.size() <= 180
        && request.resource.data.team is list
        && request.resource.data.team.size() == 6
        && request.resource.data.team[0] is string
        && request.resource.data.team[0].size() <= 32
        && request.resource.data.team[1] is string
        && request.resource.data.team[1].size() <= 32
        && request.resource.data.team[2] is string
        && request.resource.data.team[2].size() <= 32
        && request.resource.data.team[3] is string
        && request.resource.data.team[3].size() <= 32
        && request.resource.data.team[4] is string
        && request.resource.data.team[4].size() <= 32
        && request.resource.data.team[5] is string
        && request.resource.data.team[5].size() <= 32
        && request.resource.data.pattern in ['plain','grid','diagonal','rings','stars']
        && request.resource.data.customPrimary.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.customSecondary.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.portraitData is string
        && request.resource.data.portraitData.size() <= 150000
        && (request.resource.data.portraitData == '' ||
            request.resource.data.portraitData.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.bannerData is string
        && request.resource.data.bannerData.size() <= 260000
        && (request.resource.data.bannerData == '' ||
            request.resource.data.bannerData.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.updatedAt == request.time;
      allow delete: if gm() || (member() && request.auth.uid == uid);
    }


    // Shared species templates. Only the GM can author new Santara custom forms.
    function statsValid(s) {
      return s is map
        && s.keys().hasOnly(['hp','attack','defense','specialAttack','specialDefense','speed'])
        && s.keys().hasAll(['hp','attack','defense','specialAttack','specialDefense','speed'])
        && s.hp is int && s.hp >= 1 && s.hp <= 255
        && s.attack is int && s.attack >= 1 && s.attack <= 255
        && s.defense is int && s.defense >= 1 && s.defense <= 255
        && s.specialAttack is int && s.specialAttack >= 1 && s.specialAttack <= 255
        && s.specialDefense is int && s.specialDefense >= 1 && s.specialDefense <= 255
        && s.speed is int && s.speed >= 1 && s.speed <= 255;
    }
    function imageValid(value) {
      return value is string && value.size() <= 150000
        && (value == '' || value.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$'));
    }
    function urlValid(value) {
      return value is string && value.size() <= 600
        && (value == '' || value.matches('^https://.+$'));
    }
    function shortList(items, limit) {
      return items is list && items.size() <= limit;
    }
    function customValid(d) {
      return d.keys().hasOnly([
          'slug','name','baseStats','types','abilities','spriteUrl','spriteData','updatedAt'
        ])
        && d.keys().hasAll([
          'slug','name','baseStats','types','abilities','spriteUrl','spriteData','updatedAt'
        ])
        && d.slug is string && d.slug.matches('^[a-z0-9-]{2,70}$')
        && d.name is string && d.name.size() > 0 && d.name.size() <= 65
        && statsValid(d.baseStats)
        && shortList(d.types,2) && d.types.size() > 0
        && shortList(d.abilities,3)
        && urlValid(d.spriteUrl) && imageValid(d.spriteData)
        && d.updatedAt == request.time;
    }
    match /santara_species_overrides/{slug} {
      allow get, list: if member();
      allow create, update: if gm()
        && customValid(request.resource.data)
        && request.resource.data.slug == slug;
      allow delete: if gm();
    }

    // GM controls which mechanics a trainer may use. Player reads only their own document.
    function gimmicksValid(d) {
      return d.keys().hasOnly(['tera','mega','zMove','dynamax','updatedAt'])
        && d.keys().hasAll(['tera','mega','zMove','dynamax','updatedAt'])
        && d.tera is bool && d.mega is bool && d.zMove is bool && d.dynamax is bool
        && d.updatedAt == request.time;
    }
    match /santara_trainer_gimmicks/{uid} {
      allow get: if gm() || (approved() && request.auth.uid == uid);
      allow list: if gm();
      allow create, update: if gm() && gimmicksValid(request.resource.data);
      allow delete: if gm();
    }
    function gimmickGranted(uid,key) {
      return exists(/databases/$(database)/documents/santara_trainer_gimmicks/$(uid))
        && get(/databases/$(database)/documents/santara_trainer_gimmicks/$(uid)).data[key] == true;
    }

    // The GM-only Mega library does not reveal unreleased forms to players.
    // Once assigned, an individual Pokémon carries an owner-visible form snapshot.
    function megaSnapshotValid(m) {
      return m is map
        && m.keys().hasOnly(['slug','name','baseSpeciesKey','baseStats','types','ability','spriteUrl','spriteData','source'])
        && m.keys().hasAll(['slug','name','baseSpeciesKey','baseStats','types','ability','spriteUrl','spriteData','source'])
        && m.slug is string && m.slug.matches('^[a-z0-9-]{2,70}$')
        && m.name is string && m.name.size() > 0 && m.name.size() <= 85
        && m.baseSpeciesKey is string && m.baseSpeciesKey.size() > 0 && m.baseSpeciesKey.size() <= 110
        && statsValid(m.baseStats)
        && shortList(m.types,2) && m.types.size() > 0
        && m.ability is string && m.ability.size() > 0 && m.ability.size() <= 48
        && urlValid(m.spriteUrl) && imageValid(m.spriteData)
        && m.source in ['official','custom'];
    }
    match /santara_mega_forms/{slug} {
      allow get, list: if gm();
      allow create, update: if gm()
        && request.resource.data.slug == slug
        && request.resource.data.keys().hasOnly(['slug','name','baseSpeciesKey','baseStats','types','ability','spriteUrl','spriteData','source','updatedAt'])
        && request.resource.data.keys().hasAll(['slug','name','baseSpeciesKey','baseStats','types','ability','spriteUrl','spriteData','source','updatedAt'])
        && request.resource.data.slug is string && request.resource.data.slug.matches('^[a-z0-9-]{2,70}$')
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 85
        && request.resource.data.baseSpeciesKey is string && request.resource.data.baseSpeciesKey.size() > 0
        && request.resource.data.baseSpeciesKey.size() <= 110
        && statsValid(request.resource.data.baseStats)
        && shortList(request.resource.data.types,2) && request.resource.data.types.size() > 0
        && request.resource.data.ability is string && request.resource.data.ability.size() > 0 && request.resource.data.ability.size() <= 48
        && urlValid(request.resource.data.spriteUrl) && imageValid(request.resource.data.spriteData)
        && request.resource.data.source in ['official','custom']
        && request.resource.data.updatedAt == request.time;
      allow delete: if gm();
    }

    // GM controls species, base stats, levels, moves, abilities and ownership.
    // Approved Trainers can only track their own HP, status, nickname, notes and party slot.
    function pokemonValid(d) {
      return d.keys().hasOnly([
          'ownerUid','speciesKey','speciesName','source','baseStats','types','abilities',
          'spriteUrl','spriteData','nickname','level','ability','maxHp','currentHp',
          'status','slot','heldItem','moves','origin','notes','updatedAt',
          'teraType','megaForm','megaActive','teraActive','zUsed','dynamaxTurns','dynamaxUsed'
        ])
        && d.keys().hasAll([
          'ownerUid','speciesKey','speciesName','source','baseStats','types','abilities',
          'spriteUrl','spriteData','nickname','level','ability','maxHp','currentHp',
          'status','slot','heldItem','moves','origin','notes','updatedAt'
        ])
        && d.ownerUid is string && d.ownerUid.size() >= 10 && d.ownerUid.size() <= 128
        && d.speciesKey is string && d.speciesKey.size() > 0 && d.speciesKey.size() <= 110
        && d.speciesName is string && d.speciesName.size() > 0 && d.speciesName.size() <= 85
        && d.source in ['official','custom']
        && statsValid(d.baseStats)
        && shortList(d.types,2) && d.types.size() > 0
        && shortList(d.abilities,4)
        && urlValid(d.spriteUrl) && imageValid(d.spriteData)
        && d.nickname is string && d.nickname.size() <= 32
        && d.level is int && d.level >= 1 && d.level <= 100
        && d.ability is string && d.ability.size() <= 48
        && d.maxHp is int && d.maxHp >= 1 && d.maxHp <= 3000
        && d.currentHp is int && d.currentHp >= 0 && d.currentHp <= d.maxHp
        && d.status in ['None','Burned','Poisoned','Badly poisoned','Paralyzed','Asleep','Frozen']
        && d.slot is int && d.slot >= 0 && d.slot <= 6
        && d.heldItem is string && d.heldItem.size() <= 80
        && shortList(d.moves,4)
        && d.origin is string && d.origin.size() <= 150
        && d.notes is string && d.notes.size() <= 1000
        && (!('teraType' in d) || d.teraType in [
          'normal','fire','water','electric','grass','ice','fighting','poison',
          'ground','flying','psychic','bug','rock','ghost','dragon','dark','steel','fairy'
        ])
        && (!('megaForm' in d) || d.megaForm == null || megaSnapshotValid(d.megaForm))
        && (!('megaActive' in d) || d.megaActive is bool)
        && (!('teraActive' in d) || d.teraActive is bool)
        && (!('zUsed' in d) || d.zUsed is bool)
        && (!('dynamaxUsed' in d) || d.dynamaxUsed is bool)
        && (!('dynamaxTurns' in d) || (d.dynamaxTurns is int && d.dynamaxTurns >= 0 && d.dynamaxTurns <= 3))
        && !(d.get('megaActive',false) == true && d.get('teraActive',false) == true)
        && !(d.get('megaActive',false) == true && d.get('dynamaxTurns',0) > 0)
        && !(d.get('teraActive',false) == true && d.get('dynamaxTurns',0) > 0)
        && (!d.get('megaActive',false) || (d.get('megaForm',null) is map &&
           d.megaForm.baseSpeciesKey == d.speciesKey))
        && d.updatedAt == request.time;
    }
    // Repositioning a pre-V5.2 Pokémon must not require all later schema
    // fields to exist. This exception is GM-only and strictly slot/timestamp.
    function gmLegacySlotUpdate() {
      return gm()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slot','updatedAt'])
        && request.resource.data.slot is int
        && request.resource.data.slot >= 0
        && request.resource.data.slot <= 6
        && request.resource.data.updatedAt == request.time;
    }
    match /santara_pokemon/{pokemonId} {
      allow get, list: if gm() || (approved() && resource.data.ownerUid == request.auth.uid);
      allow create: if gm() && pokemonValid(request.resource.data);
      allow delete: if gm();
      allow update: if (gm() && pokemonValid(request.resource.data))
        || gmLegacySlotUpdate()
        || (approved() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'currentHp','status','slot','nickname','notes','updatedAt',
            'teraType','teraActive','megaActive','zUsed','dynamaxTurns','dynamaxUsed'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['teraType','teraActive'])
             || gimmickGranted(resource.data.ownerUid,'tera'))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['megaActive'])
             || (gimmickGranted(resource.data.ownerUid,'mega')
                && resource.data.get('megaForm',null) is map
                && resource.data.megaForm.baseSpeciesKey == resource.data.speciesKey))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['zUsed'])
             || gimmickGranted(resource.data.ownerUid,'zMove'))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dynamaxTurns','dynamaxUsed'])
             || gimmickGranted(resource.data.ownerUid,'dynamax'))
          && pokemonValid(request.resource.data));
    }



    // The finalized V5.2 values are GM-configurable instead of guessing a table.
    match /santara_battle_rules/v5_2 {
      allow get: if member();
      allow list, delete: if false;
      allow create, update: if gm()
        && request.resource.data.keys().hasOnly([
          'universalAc','offenseBands','defenseBands','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'universalAc','offenseBands','defenseBands','updatedAt'
        ])
        && (request.resource.data.universalAc == null
          || (request.resource.data.universalAc is int
            && request.resource.data.universalAc >= 1
            && request.resource.data.universalAc <= 50))
        && request.resource.data.offenseBands is list
        && request.resource.data.offenseBands.size() <= 20
        && request.resource.data.defenseBands is list
        && request.resource.data.defenseBands.size() <= 20
        && request.resource.data.updatedAt == request.time;
    }


    // Trainer-submitted Pokémon requests. A player can propose a Pokémon,
    // but only the GM can resolve a request and assign the real Pokémon.
    match /santara_pokemon_requests/{requestId} {
      allow get, list: if gm() ||
        (approved() && resource.data.ownerUid == request.auth.uid);
      // GM status also grants Trainer-level request eligibility.
      // This covers legacy root/delegated GM accounts without approval documents.
      allow create: if member()
        && request.resource.data.keys().hasOnly([
          'ownerUid','speciesKey','speciesName','level','nickname',
          'notes','status','createdAt','resolvedAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid','speciesKey','speciesName','level','nickname',
          'notes','status','createdAt','resolvedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.speciesKey is string
        && request.resource.data.speciesKey.size() > 0
        && request.resource.data.speciesKey.size() <= 110
        && request.resource.data.speciesName is string
        && request.resource.data.speciesName.size() > 0
        && request.resource.data.speciesName.size() <= 85
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 100
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 32
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 300
        && request.resource.data.status == 'pending'
        && request.resource.data.resolvedAt == null
        && request.resource.data.createdAt == request.time;
      allow update: if gm()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','resolvedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.resolvedAt == request.time;
      allow delete: if gm();
    }

    // GM-authored battle definitions readable by all approved Trainers.
    function catalogBase(d) {
      return d.slug is string && d.slug.matches('^[a-z0-9-]{2,70}$')
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 48
        && d.description is string && d.description.size() >= 1 && d.description.size() <= 1000
        && d.updatedAt == request.time;
    }
    match /santara_custom_abilities/{slug} {
      allow get, list: if member();
      allow create, update: if gm()
        && request.resource.data.keys().hasOnly(['slug','name','description','updatedAt'])
        && request.resource.data.keys().hasAll(['slug','name','description','updatedAt'])
        && catalogBase(request.resource.data)
        && request.resource.data.slug == slug;
      allow delete: if gm();
    }
    function customMoveValid(d) {
      return d.keys().hasOnly(['slug','name','description','type','category','power','accuracy','dice','updatedAt'])
        && d.keys().hasAll(['slug','name','description','type','category','power','accuracy','dice','updatedAt'])
        && catalogBase(d)
        && d.type in ['normal','fire','water','electric','grass','ice','fighting','poison',
          'ground','flying','psychic','bug','rock','ghost','dragon','dark','steel','fairy']
        && d.category in ['Physical','Special','Status']
        && (d.power == null || (d.power is int && d.power >= 0 && d.power <= 300))
        && (d.accuracy == null || (d.accuracy is int && d.accuracy >= 1 && d.accuracy <= 100))
        && d.dice is string && d.dice.size() <= 120;
    }
    match /santara_custom_moves/{slug} {
      allow get, list: if member();
      allow create, update: if gm()
        && customMoveValid(request.resource.data)
        && request.resource.data.slug == slug;
      allow delete: if gm();
    }

    // Public Trainer Card projection: only six party identities, not private battle state.
    function publicSlotValid(v) {
      return v == null || (
        v is map
        && v.keys().hasOnly(['name','species','level','artUrl','artData'])
        && v.keys().hasAll(['name','species','level','artUrl','artData'])
        && v.name is string && v.name.size() > 0 && v.name.size() <= 32
        && v.species is string && v.species.size() > 0 && v.species.size() <= 85
        && v.level is int && v.level >= 1 && v.level <= 100
        && urlValid(v.artUrl) && imageValid(v.artData)
      );
    }
    match /santara_public_parties/{uid} {
      allow get, list: if member();
      allow create, update: if (gm() || (approved() && request.auth.uid == uid))
        && request.resource.data.keys().hasOnly(['ownerUid','slots','updatedAt'])
        && request.resource.data.keys().hasAll(['ownerUid','slots','updatedAt'])
        && request.resource.data.ownerUid == uid
        && request.resource.data.slots is list
        && request.resource.data.slots.size() == 6
        && publicSlotValid(request.resource.data.slots[0])
        && publicSlotValid(request.resource.data.slots[1])
        && publicSlotValid(request.resource.data.slots[2])
        && publicSlotValid(request.resource.data.slots[3])
        && publicSlotValid(request.resource.data.slots[4])
        && publicSlotValid(request.resource.data.slots[5])
        && request.resource.data.updatedAt == request.time;
      allow delete: if gm();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
