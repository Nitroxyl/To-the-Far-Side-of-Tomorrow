rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function gm() {
      return request.auth != null
        && request.auth.uid == 'ctBLgrVgkLOzUJYTyYgU9IwejYx1';
    }
    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }
    function approved() {
      return verified()
        && exists(/databases/$(database)/documents/santara_player_access/$(request.auth.uid))
        && get(/databases/$(database)/documents/santara_player_access/$(request.auth.uid)).data.enabled == true;
    }
    function member() {
      return gm() || approved();
    }

    // GM uploads only a public snapshot; verified, approved Trainers can read it.
    match /santara_publication/current {
      allow get: if member();
      allow list, delete: if false;
      allow create, update: if gm()
        && request.resource.data.keys().hasOnly(['bundle','updatedAt'])
        && request.resource.data.keys().hasAll(['bundle','updatedAt'])
        && request.resource.data.bundle is map
        && request.resource.data.bundle.keys().hasOnly([
          'kind','version','generatedAt','sites','requests','sightings'
        ])
        && request.resource.data.bundle.kind == 'santaraPublished'
        && request.resource.data.bundle.sites is list
        && request.resource.data.bundle.requests is list
        && request.resource.data.bundle.sightings is list
        && request.resource.data.updatedAt == request.time;
    }

    // A verified player can request approval for their own Firebase UID.
    match /santara_access_requests/{uid} {
      allow get: if gm() || (verified() && request.auth.uid == uid);
      allow list: if gm();
      allow create: if verified()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','createdAt'])
        && request.resource.data.keys().hasAll(['email','createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if gm();
    }

    // Only the GM can grant or revoke access.
    match /santara_player_access/{uid} {
      allow get: if gm() || (verified() && request.auth.uid == uid);
      allow list: if gm();
      allow create, update: if gm()
        && request.resource.data.keys().hasOnly(['email','enabled','approvedAt'])
        && request.resource.data.keys().hasAll(['email','enabled','approvedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.enabled is bool
        && request.resource.data.approvedAt == request.time;
      allow delete: if gm();
    }

    // Approved Trainers can browse cards; only an owner edits their own.
    match /santara_trainer_cards/{uid} {
      allow get, list: if member();
      allow create, update: if member()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'ownerUid','trainerName','trainerClass','hometown','partnerPokemon',
          'favoriteType','theme','avatar','badgeCount','quote','updatedAt',
          'trainerTitle','team','pattern','customPrimary','customSecondary',
          'portraitData','bannerData'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid','trainerName','trainerClass','hometown','partnerPokemon',
          'favoriteType','theme','avatar','badgeCount','quote','updatedAt',
          'trainerTitle','team','pattern','customPrimary','customSecondary',
          'portraitData','bannerData'
        ])
        && request.resource.data.ownerUid == uid
        && request.resource.data.trainerName is string
        && request.resource.data.trainerName.size() > 0
        && request.resource.data.trainerName.size() <= 32
        && request.resource.data.trainerClass is string
        && request.resource.data.trainerClass.size() <= 32
        && request.resource.data.trainerTitle is string
        && request.resource.data.trainerTitle.size() <= 32
        && request.resource.data.hometown is string
        && request.resource.data.hometown.size() <= 48
        && request.resource.data.partnerPokemon is string
        && request.resource.data.partnerPokemon.size() <= 48
        && request.resource.data.favoriteType is string
        && request.resource.data.favoriteType.size() <= 30
        && request.resource.data.theme in [
          'crimson','ocean','emerald','violet','amber','midnight','rose','frost'
        ]
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 12
        && request.resource.data.badgeCount is int
        && request.resource.data.badgeCount >= 0
        && request.resource.data.badgeCount <= 8
        && request.resource.data.quote is string
        && request.resource.data.quote.size() <= 180
        && request.resource.data.team is list
        && request.resource.data.team.size() == 6
        && request.resource.data.team[0] is string
        && request.resource.data.team[0].size() <= 32
        && request.resource.data.team[1] is string
        && request.resource.data.team[1].size() <= 32
        && request.resource.data.team[2] is string
        && request.resource.data.team[2].size() <= 32
        && request.resource.data.team[3] is string
        && request.resource.data.team[3].size() <= 32
        && request.resource.data.team[4] is string
        && request.resource.data.team[4].size() <= 32
        && request.resource.data.team[5] is string
        && request.resource.data.team[5].size() <= 32
        && request.resource.data.pattern in ['plain','grid','diagonal','rings','stars']
        && request.resource.data.customPrimary.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.customSecondary.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.portraitData is string
        && request.resource.data.portraitData.size() <= 150000
        && (request.resource.data.portraitData == '' ||
            request.resource.data.portraitData.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.bannerData is string
        && request.resource.data.bannerData.size() <= 260000
        && (request.resource.data.bannerData == '' ||
            request.resource.data.bannerData.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.updatedAt == request.time;
      allow delete: if gm() || (member() && request.auth.uid == uid);
    }


    // Shared species templates. Only the GM can author new Santara custom forms.
    function statsValid(s) {
      return s is map
        && s.keys().hasOnly(['hp','attack','defense','specialAttack','specialDefense','speed'])
        && s.keys().hasAll(['hp','attack','defense','specialAttack','specialDefense','speed'])
        && s.hp is int && s.hp >= 1 && s.hp <= 255
        && s.attack is int && s.attack >= 1 && s.attack <= 255
        && s.defense is int && s.defense >= 1 && s.defense <= 255
        && s.specialAttack is int && s.specialAttack >= 1 && s.specialAttack <= 255
        && s.specialDefense is int && s.specialDefense >= 1 && s.specialDefense <= 255
        && s.speed is int && s.speed >= 1 && s.speed <= 255;
    }
    function imageValid(value) {
      return value is string && value.size() <= 150000
        && (value == '' || value.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+
      allow read, write: if false;
    }
  }
}
));
    }
    function urlValid(value) {
      return value is string && value.size() <= 600
        && (value == '' || value.matches('^https://.+
      allow read, write: if false;
    }
  }
}
));
    }
    function shortList(items, limit) {
      return items is list && items.size() <= limit;
    }
    function customValid(d) {
      return d.keys().hasOnly([
          'slug','name','baseStats','types','abilities','spriteUrl','spriteData','updatedAt'
        ])
        && d.keys().hasAll([
          'slug','name','baseStats','types','abilities','spriteUrl','spriteData','updatedAt'
        ])
        && d.slug is string && d.slug.matches('^[a-z0-9-]{2,70}
      allow read, write: if false;
    }
  }
}
)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 65
        && statsValid(d.baseStats)
        && shortList(d.types,2) && d.types.size() > 0
        && shortList(d.abilities,3)
        && urlValid(d.spriteUrl) && imageValid(d.spriteData)
        && d.updatedAt == request.time;
    }
    match /santara_species_overrides/{slug} {
      allow get, list: if member();
      allow create, update: if gm()
        && customValid(request.resource.data)
        && request.resource.data.slug == slug;
      allow delete: if gm();
    }

    // GM controls species, base stats, levels, moves, abilities and ownership.
    // Approved Trainers can only track their own HP, status, nickname, notes and party slot.
    function pokemonValid(d) {
      return d.keys().hasOnly([
          'ownerUid','speciesKey','speciesName','source','baseStats','types','abilities',
          'spriteUrl','spriteData','nickname','level','ability','maxHp','currentHp',
          'status','slot','heldItem','moves','origin','notes','updatedAt'
        ])
        && d.keys().hasAll([
          'ownerUid','speciesKey','speciesName','source','baseStats','types','abilities',
          'spriteUrl','spriteData','nickname','level','ability','maxHp','currentHp',
          'status','slot','heldItem','moves','origin','notes','updatedAt'
        ])
        && d.ownerUid is string && d.ownerUid.size() >= 10 && d.ownerUid.size() <= 128
        && d.speciesKey is string && d.speciesKey.size() > 0 && d.speciesKey.size() <= 110
        && d.speciesName is string && d.speciesName.size() > 0 && d.speciesName.size() <= 85
        && d.source in ['official','custom']
        && statsValid(d.baseStats)
        && shortList(d.types,2) && d.types.size() > 0
        && shortList(d.abilities,4)
        && urlValid(d.spriteUrl) && imageValid(d.spriteData)
        && d.nickname is string && d.nickname.size() <= 32
        && d.level is int && d.level >= 1 && d.level <= 100
        && d.ability is string && d.ability.size() <= 48
        && d.maxHp is int && d.maxHp >= 1 && d.maxHp <= 3000
        && d.currentHp is int && d.currentHp >= 0 && d.currentHp <= d.maxHp
        && d.status in ['None','Burned','Poisoned','Badly poisoned','Paralyzed','Asleep','Frozen']
        && d.slot is int && d.slot >= 0 && d.slot <= 6
        && d.heldItem is string && d.heldItem.size() <= 80
        && shortList(d.moves,4)
        && d.origin is string && d.origin.size() <= 150
        && d.notes is string && d.notes.size() <= 1000
        && d.updatedAt == request.time;
    }
    match /santara_pokemon/{pokemonId} {
      allow get, list: if gm() || (approved() && resource.data.ownerUid == request.auth.uid);
      allow create, delete: if gm() && (request.method == 'delete' || pokemonValid(request.resource.data));
      allow update: if gm() && pokemonValid(request.resource.data)
        || (approved() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'currentHp','status','slot','nickname','notes','updatedAt'
          ])
          && pokemonValid(request.resource.data));
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
